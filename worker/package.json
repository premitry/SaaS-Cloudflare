{
  "name": "@cfp/worker",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply cfp_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cfp_db --remote",
    "db:seed:local": "wrangler d1 execute cfp_db --local --file=./migrations/seed.sql",
    "db:seed:remote": "wrangler d1 execute cfp_db --remote --file=./migrations/seed.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.6.3",
    "wrangler": "^3.99.0"
  }
}
